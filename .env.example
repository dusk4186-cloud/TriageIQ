# ==============================================================================
# Jira MCP Server & Defect RAG Configuration
# ==============================================================================

# 1. Atlassian Jira Cloud Settings (Mock Mode Enabled by Default)
# ------------------------------------------------------------------------------
# Set to 'true' to run without a Jira account using in-memory simulated tickets
JIRA_MOCK_MODE=true

# Safety Switch: Set to 'true' (default) to block mutating tools (create, update, comment, transition).
# Set to 'false' only when you want to permit write operations to Jira.
JIRA_READ_ONLY=true

# Your Jira instance base URL (e.g. https://your-domain.atlassian.net)
JIRA_URL=https://your-domain.atlassian.net

# Your Atlassian account email
JIRA_EMAIL=your-email@example.com

# Jira API Token generated from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SCRUM

# 2. Jira Server / Data Center (Optional, for PAT authentication)
# ------------------------------------------------------------------------------
# JIRA_BEARER_TOKEN=your_personal_access_token_here

# 3. Defect RAG & Multi-Model Settings
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Optional secondary Gemini API key for failover (check your provider's terms before using a second key)
# GEMINI_BACKUP_API_KEY=your-backup-gemini-api-key
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash

# Optional: Groq cross-provider fallback
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile
